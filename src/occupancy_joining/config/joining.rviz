Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 64; 64; 64
  Displays:
  - Class: occupancy_joining/GrayscaleMap
    Name: Map
    Enabled: true
    Alpha: 1
    Color Scheme: map
    Topic:
      Value: /occupancy_joining/reintegrated/map
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  - Class: rviz_default_plugins/Path
    Name: Trajectory
    Enabled: true
    Color: 40; 130; 220
    Topic:
      Value: /occupancy_joining/reintegrated/trajectory
      Reliability Policy: Reliable
      Durability Policy: Transient Local
      Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Scale: 15
      X: 0
      Y: 0
Window Geometry:
  Width: 1200
  Height: 850
